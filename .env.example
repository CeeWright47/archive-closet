# Neon connection string — find this in your Neon dashboard under "Connection Details"
# Use the pooled connection string (labelled "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Your Anthropic API key — https://console.anthropic.com/keys
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Set to "true" locally if you want to test the Neon API with `vercel dev`
# Leave unset when using `npm run dev` (will use localStorage instead)
# VITE_USE_API=true
